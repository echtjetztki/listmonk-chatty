FROM listmonk/listmonk:latest

# Vercel's container runtime provides PORT. Clear listmonk's inherited
# docker entrypoint so we can control the startup sequence directly.
ENTRYPOINT []

# Vercel routes HTTP traffic to the runtime PORT (default 80).
EXPOSE 80

# The official image ships a config.toml (from config.toml.sample) in /listmonk.
# listmonk loads it and LISTMONK_* env vars override the values (db.*, app.*).
# NOTE: do NOT pass --config="" here — an empty path makes listmonk exit with
# "config file not found" because the default "config.toml" gets overridden.
CMD ["sh", "-c", "set -e; export LISTMONK_app__address=0.0.0.0:${PORT:-80}; echo \"Starting listmonk on ${LISTMONK_app__address}\"; ./listmonk --install --idempotent --yes; ./listmonk --upgrade --yes; exec ./listmonk"]
