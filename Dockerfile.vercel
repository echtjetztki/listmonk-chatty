FROM listmonk/listmonk:latest

EXPOSE 9000

# Install the schema only when needed, apply pending migrations, then start.
# Vercel provides PORT at runtime; listmonk is configured to listen on it.
CMD ["sh", "-c", "export LISTMONK_app__address=0.0.0.0:${PORT:-9000}; ./listmonk --install --idempotent --yes --config '' && ./listmonk --upgrade --yes --config '' && exec ./listmonk --config ''"]
