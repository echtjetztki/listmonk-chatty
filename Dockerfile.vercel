FROM listmonk/listmonk:latest

# listmonk's official image listens on port 9000 by default.
ENV LISTMONK_app__address=0.0.0.0:9000

EXPOSE 9000

# The database schema install/upgrade is idempotent.
# Database credentials are supplied as LISTMONK_* environment variables.
CMD ["sh", "-c", "./listmonk --config=\"\" --install --idempotent --yes && exec ./listmonk --config=\"\""]
